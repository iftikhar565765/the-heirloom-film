{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-heirloom-film",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heirloom-invitations",
      "database_id": "fd6c18a6-32a8-470c-9628-ffd6530b885c"
    }
  ]
}
