{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-heirloom-film",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heirloom-invitations",
      "database_id": "86c8561a-176d-43bf-baae-258de6869ec5"
    }
  ]
}
